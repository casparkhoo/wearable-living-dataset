# Web console configuration. Copy to .env.local for local development, and set
# the same values as Environment Variables in the Vercel project.

# Backend API: https://<API_DOMAIN> from deployment/cloud/.env.
VITE_BACKEND_URL=https://api.example.org

# Identity provider. Sign-in is hidden unless both of these are set, and the
# console falls back to the deployment-wide bearer token.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The publishable key is designed to be shipped in a browser bundle. NEVER put
# a Supabase secret / service_role key here -- it would be world-readable.

# Legacy shared bearer token. Only needed while AUTH_ALLOW_SHARED_TOKEN is true
# on the backend; a signed-in user's token takes priority over it.
# VITE_BACKEND_TOKEN=
