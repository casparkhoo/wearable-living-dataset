# Backend service configuration
# Listen on all local interfaces so the Android phone can reach the API.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# MQTT broker used by the Android application
MQTT_BROKER_URL=tcp://127.0.0.1:1883
MQTT_TOPIC_FILTER=sensors/#
MQTT_STATUS_TOPIC_PREFIX=status
MQTT_USERNAME=
MQTT_PASSWORD=

# MySQL wearable evidence database
# For a local passwordless user, set MYSQL_PASSWORD= with no value.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wearable_app
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=wearable_living_dataset

# Optional ML control plane. The backend should work when this is disabled.
ML_INFERENCE_ENABLED=false
ML_INFERENCE_URL=http://127.0.0.1:5000
# Head the worker applies to live PPG windows; unset to run no model live.
ML_LIVE_HEAD_ID=hr_ring_embraceplus

# Optional REST bearer token. Leave unset for local development.
# API_TOKEN=

# Identity provider (Supabase Auth). User authentication is enabled as soon as
# SUPABASE_URL or AUTH_JWKS_URL is set; projects created since May 2025 sign
# asymmetrically and are verified through the JWKS endpoint.
# SUPABASE_URL=https://<project-ref>.supabase.co
# AUTH_JWKS_URL=
# Legacy symmetric secret, only for older projects issuing HS256 tokens.
# SUPABASE_JWT_SECRET=
# AUTH_JWT_AUDIENCE=authenticated
# AUTH_JWT_ISSUER=
# Accept the deployment-wide API_TOKEN as well as user tokens. Set to false
# once every client signs in, to retire the shared credential.
# AUTH_ALLOW_SHARED_TOKEN=true
