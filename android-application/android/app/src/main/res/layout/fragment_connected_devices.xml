<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devices_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Remembered wearables, reconnected automatically ───────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your wearables"
                    android:textAppearance="@style/TextAppearance.WearableController.Section" />

                <TextView
                    android:id="@+id/devices_reconnect_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="Wearables you connect are remembered and reconnect by themselves."
                    android:textColor="@color/warm_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/devices_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/devices_scan_button"
            style="@style/Widget.WearableController.BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Add a wearable" />

        <!-- ── Nearby devices while searching ────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/devices_nearby_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby"
                    android:textAppearance="@style/TextAppearance.WearableController.Section" />

                <TextView
                    android:id="@+id/devices_nearby_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="10dp"
                    android:text="Looking for wearables… switch yours on and keep it close."
                    android:textColor="@color/warm_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/devices_nearby_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/devices_logs_toggle"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Show logs"
            android:textAllCaps="false" />

        <ScrollView
            android:id="@+id/devices_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@drawable/bg_console"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/devices_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/console_text"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
