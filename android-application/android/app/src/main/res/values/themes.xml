<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.WearableController" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_dark</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/warm_text</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/warm_muted</item>
        <item name="colorOutline">@color/warm_border</item>
        <item name="colorOutlineVariant">@color/warm_border</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Widget styling -->
        <item name="tabStyle">@style/Widget.WearableController.TabLayout</item>
        <item name="materialCardViewStyle">@style/Widget.WearableController.CardView</item>
    </style>

    <style name="Widget.WearableController.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@android:color/transparent</item>
        <item name="tabSelectedTextColor">@color/on_brand</item>
        <item name="tabTextColor">@color/warm_muted</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabMinWidth">64dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="tabTextAppearance">@style/TextAppearance.WearableController.Tab</item>
        <item name="tabPaddingStart">10dp</item>
        <item name="tabPaddingEnd">10dp</item>
    </style>

    <style name="Widget.WearableController.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/warm_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">14dp</item>
    </style>

    <!-- Section heading text -->
    <style name="TextAppearance.WearableController.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/warm_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- The one action that matters on a screen: start or stop recording,
         add a wearable. Big enough to hit without looking closely. -->
    <style name="Widget.WearableController.BigButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">46dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Activity label choices: tap to start, tap again to stop. -->
    <style name="Widget.WearableController.LabelChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- Material's 24dp side padding leaves too little room in a third of
             the screen and splits words across lines. -->
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.WearableController.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="TextAppearance.WearableController.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/warm_muted</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
