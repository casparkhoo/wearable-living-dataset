# Copy to .env on the server. Never commit the populated file.
# Generate each password and secret with:  openssl rand -hex 32
# Full walkthrough: docs/SELF_HOSTING.md

# Public hostnames. Both must resolve to this server before the first start,
# because Caddy requests their TLS certificates. With no domain of your own,
# api.<public-ip>.nip.io and mqtt.<public-ip>.nip.io work.
API_DOMAIN=api.example.org
MQTT_DOMAIN=mqtt.example.org

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=wearable_living_dataset
MYSQL_USER=wearable_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MQTT_USERNAME=wearable_backend
MQTT_PASSWORD=replace-with-a-long-random-mqtt-password
MQTT_ANDROID_USERNAME=wearable_android
MQTT_ANDROID_PASSWORD=replace-with-a-long-random-android-mqtt-password

# Used by the backend process and harmless when overridden by compose.
ML_INFERENCE_ENABLED=true
# The compose file points the backend at the papagei service.
ML_LIVE_HEAD_ID=hr_ring_stretch_v2

# Required before exposing the API publicly.
API_TOKEN=replace-with-a-long-random-api-token

# Identity provider (Supabase Auth). User authentication is enabled as soon as
# SUPABASE_URL or AUTH_JWKS_URL is set; projects created since May 2025 sign
# asymmetrically and are verified through the JWKS endpoint.
# SUPABASE_URL=https://<project-ref>.supabase.co
# AUTH_JWKS_URL=
# Legacy symmetric secret, only for older projects issuing HS256 tokens.
# SUPABASE_JWT_SECRET=
# AUTH_JWT_AUDIENCE=authenticated
# AUTH_JWT_ISSUER=
# Accept the deployment-wide API_TOKEN as well as user tokens. Set to false
# once every client signs in, to retire the shared credential.
# AUTH_ALLOW_SHARED_TOKEN=true

# Per-participant broker accounts. Set this and every participant gets their
# own MQTT credential, derived as sha256("<secret>:mqtt:<user_id>"), which the
# backend hands them from GET /api/me/mqtt-credentials. Leave it unset and
# participants keep sharing one account, which means any phone can subscribe
# to sensors/# and read every other participant's stream.
#   openssl rand -hex 32
# scripts/sync_mqtt_users.sh writes the broker's password file from it; the
# timer installed by scripts/install_server_timers.sh runs it every minute, so
# new participants can stream within a minute of first signing in.
MQTT_USER_SECRET=replace-with-a-long-random-secret

# Database backups (scripts/backup_db.sh, run nightly by the same timers).
# Dumps are kept on the server for BACKUP_KEEP_DAYS; copy them off the server
# with scripts/pull_backups.sh. State this period in the consent form: data
# erased from the live database survives in backups until they rotate out.
BACKUP_DIR=/home/ubuntu/wearable-backups
BACKUP_KEEP_DAYS=14
