# Settings for the local stack. scripts/local.sh up creates deployment/local/.env
# from this file, with fresh random secrets, the first time it runs. Never
# commit the populated file.

# Identity provider (Supabase project -> Settings -> API). Both values are
# public by design; the same project as a cloud instance can be shared, so
# the same accounts sign in to both.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Generated by scripts/local.sh: database passwords, the backend's broker
# account, the secret participant broker passwords are derived from, and an
# unused shared API token.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MQTT_PASSWORD=
MQTT_USER_SECRET=
API_TOKEN=

# Port for the console, API and broker (http://<this computer>:8088).
GATEWAY_PORT=8088
# 0.0.0.0 lets phones on the same network connect; 127.0.0.1 keeps it to
# this computer (use a tunnel then, see docs/LOCAL_HOSTING.md).
GATEWAY_BIND=0.0.0.0

# MySQL memory for cached data. 1G suits a laptop; lower it on a small machine.
MYSQL_BUFFER_POOL=1G

# PaPaGei live heart rate. false skips the model worker's work.
ML_INFERENCE_ENABLED=true
ML_LIVE_HEAD_ID=hr_ring_stretch_v2
# Heart rate shown on the phone, glasses and console: papagei (falls back to the
# rules when the model has no fresh estimate) or rules. Display only: both
# methods are stored as derived results either way.
LIVE_HR_SOURCE=papagei
